<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CrossPaste"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phase 2B - FCM push"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Laptop IP (printed by the relay)"
        android:textSize="13sp"
        android:textColor="#333333"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/ipInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="e.g. 192.168.1.10"
            android:inputType="number|numberDecimal"
            android:digits="0123456789." />

        <Button
            android:id="@+id/startBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start" />
    </LinearLayout>

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop service"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tokenText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FCM token: fetching…"
        android:textSize="12sp"
        android:textColor="#666666"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="After tapping Start, the notification appears. Paste works on Wi-Fi AND mobile data now."
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:padding="12dp"
        android:background="#F5F5F5" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tip: the phone must connect to the relay on the same Wi-Fi at least once to register its FCM token. After that, push works from anywhere."
        android:textSize="12sp"
        android:textColor="#888888"
        android:lineSpacingExtra="2dp" />
</LinearLayout>
