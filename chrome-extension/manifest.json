{
  "manifest_version": 3,
  "name": "CrossPaste",
  "version": "0.3.0",
  "description": "Send selected text from your laptop to your phone's clipboard.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
