{
  "manifest_version": 3,
  "name": "CrossPaste Phase 1",
  "version": "0.1.0",
  "description": "Send selected text from this browser to your phone clipboard.",
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CrossPaste"
  }
}
